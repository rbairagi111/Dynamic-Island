{
  "manifest_version": 3,
  "name": "Dynamic Island AI Helper",
  "version": "1.0.9",
  "description": "Pushes Claude, ChatGPT, and Gemini reply-complete events to Dynamic Island with no polling lag.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "windows", "scripting", "webRequest"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://claude.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://claude.com/*"
      ],
      "js": ["shared.js", "content-claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["shared.js", "content-chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content-gemini-page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["shared.js", "content-gemini.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
